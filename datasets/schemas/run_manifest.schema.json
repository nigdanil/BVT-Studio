{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BVT research run v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "bvt.research-run.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "collection_id": {
      "enum": [
        "synthetic_chatgpt",
        "real_wikimedia"
      ]
    },
    "status": {
      "enum": [
        "prepared",
        "outputs_recorded"
      ]
    },
    "preset_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "effect_parameters": {
      "type": "object"
    },
    "tool_versions": {
      "type": "object",
      "properties": {
        "run_manager": {
          "const": "1.0"
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "pillow": {
          "type": "string",
          "minLength": 1
        },
        "declared_engine_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "run_manager",
        "python",
        "pillow",
        "declared_engine_versions"
      ],
      "additionalProperties": false
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "git_dirty": {
      "type": "boolean"
    },
    "source_code_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "qa_report_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "image_id": {
            "type": "string",
            "pattern": "^(chatgpt|wikimedia)_[0-9]{6}$"
          },
          "source_group_id": {
            "type": "string",
            "minLength": 1
          },
          "input_path": {
            "type": "string",
            "pattern": "^data_local/(synthetic_chatgpt/clean/images/chatgpt_[0-9]{6}\\.png|real_wikimedia/clean/images/wikimedia_[0-9]{6}\\.jpg)$"
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "output_path": {
            "type": "string",
            "pattern": "^augmented/images/(chatgpt|wikimedia)_[0-9]{6}\\.png$"
          },
          "output_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "label_path": {
            "type": "null"
          },
          "mask_path": {
            "type": "null"
          },
          "qa_status": {
            "enum": [
              "pending",
              "PASS",
              "REVIEW",
              "REJECT",
              "ERROR"
            ]
          },
          "generated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "image_id",
          "source_group_id",
          "input_path",
          "input_sha256",
          "width",
          "height",
          "output_path",
          "output_sha256",
          "label_path",
          "mask_path",
          "qa_status",
          "generated_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "collection_id",
    "status",
    "preset_id",
    "seed",
    "effect_parameters",
    "tool_versions",
    "git_commit",
    "git_dirty",
    "source_code_sha256",
    "dataset_manifest_sha256",
    "created_at",
    "recorded_at",
    "qa_report_sha256",
    "records"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "prepared"
          }
        }
      },
      "then": {
        "properties": {
          "recorded_at": {
            "type": "null"
          },
          "qa_report_sha256": {
            "type": "null"
          },
          "records": {
            "items": {
              "properties": {
                "output_sha256": {
                  "type": "null"
                },
                "qa_status": {
                  "const": "pending"
                },
                "generated_at": {
                  "type": "null"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "records": {
            "items": {
              "properties": {
                "output_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "qa_report_sha256": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "items": {
              "properties": {
                "qa_status": {
                  "const": "pending"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "records": {
            "items": {
              "properties": {
                "qa_status": {
                  "enum": [
                    "PASS",
                    "REVIEW",
                    "REJECT",
                    "ERROR"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
